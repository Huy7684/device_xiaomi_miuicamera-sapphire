# Google Lens
ro.com.google.lens.oem_camera_package=com.android.camera

# Framework allowlists
persist.vendor.camera.privapp.list=com.android.camera

# MiuiCamera
ro.miui.notch=1

# Live Photo support (3 = Dynamic/HyperOS Live Photo)
ro.product.camera.livephoto.support=3

# Auxiliary camera package list
vendor.camera.aux.packagelist=com.android.camera

# Fix delay / unclickable placeholder photo on AOSP
# (Bypass offline parallel processing daemon queue so photos save immediately)
persist.vendor.camera.parallel.enable=0
vendor.camera.parallel.enable=0
persist.camera.parallel.enable=0
ro.vendor.camera.parallel.enable=0

