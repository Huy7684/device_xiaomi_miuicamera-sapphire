From 206fe73e2de45e519dd2a6a8ee61d34a6cdaf68f Mon Sep 17 00:00:00 2001
From: Huy7684 <huyplus7684@gmail.com>
Date: Sun, 1 Nov 2026 17:46:49 +0700
Subject: [PATCH] Fix NullPointerException when saving watermark photos without
 parallel capture result

---
 smali_classes2/s9/c.smali | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/smali_classes2/s9/c.smali b/smali_classes2/s9/c.smali
index 0a1824f8..6426b186 100644
--- a/smali_classes2/s9/c.smali
+++ b/smali_classes2/s9/c.smali
@@ -185,6 +185,15 @@
 .method public static c(Landroid/hardware/camera2/TotalCaptureResult;)Lyh/b;
     .locals 10
 
+    if-nez p0, :cond_c_not_null
+
+    new-instance v0, Lyh/b;
+
+    invoke-direct {v0}, Lyh/b;-><init>()V
+
+    return-object v0
+
+    :cond_c_not_null
     sget-object v0, Landroid/hardware/camera2/CaptureResult;->SENSOR_EXPOSURE_TIME:Landroid/hardware/camera2/CaptureResult$Key;
 
     invoke-virtual {p0, v0}, Landroid/hardware/camera2/CaptureResult;->get(Landroid/hardware/camera2/CaptureResult$Key;)Ljava/lang/Object;
@@ -401,10 +410,17 @@
 
     iget-object v3, v1, Lfh/q;->g:Lcom/xiaomi/protocol/ICustomCaptureResult;
 
+    if-eqz v3, :cond_no_ccr
+
     invoke-static {v3, v4}, Lcom/xiaomi/protocol/ICustomCaptureResult;->toTotalCaptureResult(Lcom/xiaomi/protocol/ICustomCaptureResult;I)Landroid/hardware/camera2/TotalCaptureResult;
 
     move-result-object v3
 
+    goto :cond_3
+
+    :cond_no_ccr
+    const/4 v3, 0x0
+
     :cond_3
     invoke-static {v3}, Ls9/c;->c(Landroid/hardware/camera2/TotalCaptureResult;)Lyh/b;
 
-- 
